{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["@tony.ganchev/eslint-plugin-header"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@tony.ganchev/header/header": [
      "error",
      {
        "header": {
          "file": "scripts/license-header.ts"
        }
      }
    ]
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["scripts/license-header.ts"]
}
